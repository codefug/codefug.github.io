{
  "name": "codefug.blog",
  "version": "0.3.0",
  "private": true,
  "homepage": "https://codefug.github.io",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate-mdx": "node scripts/generateMdxMap.mjs",
    "validate-posts": "node scripts/validatePosts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prebuild": "pnpm run generate-mdx && pnpm run validate-posts",
    "predev": "pnpm run generate-mdx",
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve@latest out",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepare": "husky",
    "deploy": "type nul > out/.nojekyll && gh-pages -d out --dotfiles"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.1",
    "@next/third-parties": "^16.3.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/canvas-confetti": "^1.9.0",
    "@types/mdx": "^2.0.14",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "minisearch": "^7.2.0",
    "motion": "^13.1.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "pretendard": "^1.3.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "schema-dts": "^2.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "usehooks-ts": "^3.1.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "gh-pages": "^6.3.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
